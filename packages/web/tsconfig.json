{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@openspec-ide/core": ["../core/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
